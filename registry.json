{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "ptrckschrdtr-ds",
  "homepage": "https://ds.ptrckschrdtr.de",
  "items": [

    {
      "name": "tokens-global",
      "type": "registry:style",
      "title": "Global Tokens",
      "description": "Raw values (colors, spacing, radius, typography, shadows, motion), sourced from the Figma GTC design system. Always install this first — it is the foundation of the entire system.",
      "files": [
        {
          "path": "registry/tokens/base/global.css",
          "type": "registry:style",
          "target": "src/styles/ds/global.css"
        },
        {
          "path": "registry/tokens/base/reset.css",
          "type": "registry:style",
          "target": "src/styles/ds/reset.css"
        }
      ]
    },

    {
      "name": "tokens-theme",
      "type": "registry:style",
      "title": "Theme Tokens",
      "description": "Theme token layer that maps global tokens to meaning (surface, text, border, button, status). Install after tokens-global. Light mode is the default; Dark mode activates via [data-theme=\"dark\"].",
      "registryDependencies": [
        "ptrckschrdtr-ds/tokens-global"
      ],
      "files": [
        {
          "path": "registry/tokens/theme/theme.css",
          "type": "registry:style",
          "target": "src/styles/ds/theme.css"
        }
      ]
    },

    {
      "name": "input",
      "type": "registry:component",
      "title": "Input",
      "description": "Form input field with label, hint text, and validation states. Variants: default, error, success. Sizes: sm, md, lg. Supports textarea, required, disabled, readonly. Available as input.astro and input.tsx (React).",
      "registryDependencies": [
        "ptrckschrdtr-ds/tokens-theme"
      ],
      "files": [
        {
          "path": "registry/components/input/input.css",
          "type": "registry:style",
          "target": "src/components/ds/input/input.css"
        },
        {
          "path": "registry/components/input/input.astro",
          "type": "registry:component",
          "target": "src/components/ds/input/input.astro"
        },
        {
          "path": "registry/components/input/input.tsx",
          "type": "registry:component",
          "target": "src/components/ds/input/input.tsx"
        }
      ]
    },

    {
      "name": "card",
      "type": "registry:component",
      "title": "Card",
      "description": "Flexible container component with optional header, body, footer, and media slots. Variants: default, outlined, ghost, elevated. Supports interactive hover states and href for clickable cards. React version exports sub-components: CardHeader, CardTitle, CardDescription, CardBody, CardFooter, CardMedia.",
      "registryDependencies": [
        "ptrckschrdtr-ds/tokens-theme"
      ],
      "files": [
        {
          "path": "registry/components/card/card.css",
          "type": "registry:style",
          "target": "src/components/ds/card/card.css"
        },
        {
          "path": "registry/components/card/card.astro",
          "type": "registry:component",
          "target": "src/components/ds/card/card.astro"
        },
        {
          "path": "registry/components/card/card.tsx",
          "type": "registry:component",
          "target": "src/components/ds/card/card.tsx"
        }
      ]
    },

    {
      "name": "badge",
      "type": "registry:component",
      "title": "Badge",
      "description": "Inline label for status, categories, or metadata. Variants: default, primary, secondary, success, warning, error, info. Styles: solid, subtle, outline. Sizes: sm, md, lg. Supports dot indicator.",
      "registryDependencies": [
        "ptrckschrdtr-ds/tokens-theme"
      ],
      "files": [
        {
          "path": "registry/components/badge/badge.css",
          "type": "registry:style",
          "target": "src/components/ds/badge/badge.css"
        },
        {
          "path": "registry/components/badge/badge.astro",
          "type": "registry:component",
          "target": "src/components/ds/badge/badge.astro"
        },
        {
          "path": "registry/components/badge/badge.tsx",
          "type": "registry:component",
          "target": "src/components/ds/badge/badge.tsx"
        }
      ]
    },

    {
      "name": "button",
      "type": "registry:component",
      "title": "Button",
      "description": "Base button component. Variants: primary, secondary, ghost, danger. Sizes: sm, md, lg. Supports href (renders as <a>), loading state, icon-only, and full-width. Available as button.astro and button.tsx (React).",
      "registryDependencies": [
        "ptrckschrdtr-ds/tokens-theme"
      ],
      "files": [
        {
          "path": "registry/components/button/button.css",
          "type": "registry:style",
          "target": "src/components/ds/button/button.css"
        },
        {
          "path": "registry/components/button/button.astro",
          "type": "registry:component",
          "target": "src/components/ds/button/button.astro"
        },
        {
          "path": "registry/components/button/button.tsx",
          "type": "registry:component",
          "target": "src/components/ds/button/button.tsx"
        }
      ]
    },

    {
      "name": "select",
      "type": "registry:component",
      "title": "Select",
      "description": "Native select dropdown with label, hint text, and validation states. Variants: default, error, success. Sizes: sm, md, lg. Supports multiple (listbox) mode, required, disabled. Available as select.astro and select.tsx (React).",
      "registryDependencies": [
        "ptrckschrdtr-ds/tokens-theme"
      ],
      "files": [
        {
          "path": "registry/components/select/select.css",
          "type": "registry:style",
          "target": "src/components/ds/select/select.css"
        },
        {
          "path": "registry/components/select/select.astro",
          "type": "registry:component",
          "target": "src/components/ds/select/select.astro"
        },
        {
          "path": "registry/components/select/select.tsx",
          "type": "registry:component",
          "target": "src/components/ds/select/select.tsx"
        }
      ]
    },

    {
      "name": "checkbox",
      "type": "registry:component",
      "title": "Checkbox",
      "description": "Single checkbox control with an optional label. States: unchecked, checked, disabled.",
      "registryDependencies": [
        "ptrckschrdtr-ds/tokens-theme"
      ],
      "files": [
        {
          "path": "registry/components/checkbox/checkbox.css",
          "type": "registry:style",
          "target": "src/components/ds/checkbox/checkbox.css"
        },
        {
          "path": "registry/components/checkbox/checkbox.astro",
          "type": "registry:component",
          "target": "src/components/ds/checkbox/checkbox.astro"
        },
        {
          "path": "registry/components/checkbox/checkbox.tsx",
          "type": "registry:component",
          "target": "src/components/ds/checkbox/checkbox.tsx"
        }
      ]
    },

    {
      "name": "switch",
      "type": "registry:component",
      "title": "Switch",
      "description": "On/off toggle control with an optional label. States: off, on, disabled.",
      "registryDependencies": [
        "ptrckschrdtr-ds/tokens-theme"
      ],
      "files": [
        {
          "path": "registry/components/switch/switch.css",
          "type": "registry:style",
          "target": "src/components/ds/switch/switch.css"
        },
        {
          "path": "registry/components/switch/switch.astro",
          "type": "registry:component",
          "target": "src/components/ds/switch/switch.astro"
        },
        {
          "path": "registry/components/switch/switch.tsx",
          "type": "registry:component",
          "target": "src/components/ds/switch/switch.tsx"
        }
      ]
    }

  ]
}
