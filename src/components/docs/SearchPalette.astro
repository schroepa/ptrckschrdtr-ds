---
/**
 * ptrckschrdtr-ds — Docs Site: Search Palette
 * ─────────────────────────────────────────
 * A ⌘K/Ctrl+K search overlay listing every page (Home, Tokens, all 11
 * components), filterable as you type, with arrow-key navigation and
 * Enter-to-open. Trigger button's press/hover feel is adapted from
 * bencho.dev's "Search" block (MIT) — the expand-to-field interaction
 * itself was judged too cramped for our header (logo + hamburger +
 * toggle already share the space on mobile), so this uses a centered
 * overlay instead, in the same spirit as the trigger. Docs-site chrome
 * only — not part of the distributed registry.
 */

const pages = [
  { label: 'Home', href: '/', group: 'Pages' },
  { label: 'Tokens', href: '/tokens', group: 'Pages' },
  { label: 'Button', href: '/components/button', group: 'Components' },
  { label: 'Input', href: '/components/input', group: 'Components' },
  { label: 'Card', href: '/components/card', group: 'Components' },
  { label: 'Badge', href: '/components/badge', group: 'Components' },
  { label: 'Select', href: '/components/select', group: 'Components' },
  { label: 'Checkbox', href: '/components/checkbox', group: 'Components' },
  { label: 'Switch', href: '/components/switch', group: 'Components' },
  { label: 'Avatar', href: '/components/avatar', group: 'Components' },
  { label: 'Separator', href: '/components/separator', group: 'Components' },
  { label: 'Alert', href: '/components/alert', group: 'Components' },
  { label: 'Tabs', href: '/components/tabs', group: 'Components' },
]
---

<button type="button" class="search-trigger" id="search-trigger" aria-label="Search">
  <svg class="search-trigger__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="11" cy="11" r="8" />
    <path d="m21 21-4.3-4.3" />
  </svg>
  <span class="search-trigger__label">Search</span>
  <kbd class="search-trigger__kbd">⌘K</kbd>
</button>

<div class="search-backdrop" id="search-backdrop">
  <div class="search-panel" role="dialog" aria-modal="true" aria-label="Search">
    <div class="search-panel__field">
      <svg class="search-panel__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8" />
        <path d="m21 21-4.3-4.3" />
      </svg>
      <input
        type="text"
        id="search-input"
        class="search-panel__input"
        placeholder="Search pages and components…"
        autocomplete="off"
        spellcheck="false"
      />
      <kbd class="search-panel__esc">Esc</kbd>
    </div>
    <div class="search-panel__results" id="search-results" role="listbox"></div>
  </div>
</div>

<script define:vars={{ pages }}>
  const trigger = document.getElementById('search-trigger')
  const backdrop = document.getElementById('search-backdrop')
  const input = document.getElementById('search-input')
  const results = document.getElementById('search-results')

  let activeIndex = 0
  let currentMatches = []

  function render(query) {
    const q = query.trim().toLowerCase()
    currentMatches = q ? pages.filter((p) => p.label.toLowerCase().includes(q)) : pages
    activeIndex = 0
    results.innerHTML = ''

    if (currentMatches.length === 0) {
      const empty = document.createElement('div')
      empty.className = 'search-panel__empty'
      empty.textContent = 'No matches.'
      results.appendChild(empty)
      return
    }

    let currentGroup = ''
    currentMatches.forEach((page, index) => {
      if (page.group !== currentGroup) {
        currentGroup = page.group
        const heading = document.createElement('div')
        heading.className = 'search-panel__group'
        heading.textContent = currentGroup
        results.appendChild(heading)
      }
      const link = document.createElement('a')
      link.href = page.href
      link.className = 'search-panel__result'
      link.dataset.index = String(index)
      link.setAttribute('role', 'option')
      link.textContent = page.label
      results.appendChild(link)
    })

    highlight()
  }

  function highlight() {
    results.querySelectorAll('.search-panel__result').forEach((el) => {
      const isActive = Number(el.dataset.index) === activeIndex
      el.classList.toggle('search-panel__result--active', isActive)
      el.setAttribute('aria-selected', String(isActive))
      if (isActive) el.scrollIntoView({ block: 'nearest' })
    })
  }

  function open() {
    backdrop.classList.add('search-backdrop--visible')
    input.value = ''
    render('')
    setTimeout(() => input.focus(), 0)
  }

  function close() {
    backdrop.classList.remove('search-backdrop--visible')
    trigger.focus()
  }

  function navigate(href) {
    window.location.href = href
  }

  trigger.addEventListener('click', open)
  backdrop.addEventListener('click', (e) => {
    if (e.target === backdrop) close()
  })

  input.addEventListener('input', () => render(input.value))

  document.addEventListener('keydown', (e) => {
    const isOpen = backdrop.classList.contains('search-backdrop--visible')
    const isCmdK = (e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k'

    if (isCmdK) {
      e.preventDefault()
      isOpen ? close() : open()
      return
    }

    if (!isOpen) return

    if (e.key === 'Escape') {
      close()
    } else if (e.key === 'ArrowDown') {
      e.preventDefault()
      if (currentMatches.length === 0) return
      activeIndex = (activeIndex + 1) % currentMatches.length
      highlight()
    } else if (e.key === 'ArrowUp') {
      e.preventDefault()
      if (currentMatches.length === 0) return
      activeIndex = (activeIndex - 1 + currentMatches.length) % currentMatches.length
      highlight()
    } else if (e.key === 'Enter') {
      e.preventDefault()
      const match = currentMatches[activeIndex]
      if (match) navigate(match.href)
    }
  })

  results.addEventListener('click', (e) => {
    const link = e.target.closest('.search-panel__result')
    if (link) {
      e.preventDefault()
      navigate(link.getAttribute('href'))
    }
  })
</script>

<style>
  /* ── Trigger ───────────────────────────────────────────── */
  .search-trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--global-size-unit-2);
    height: var(--global-control-height-31);
    padding: 0 var(--global-size-unit-3);
    border: 1px solid var(--theme-border-default);
    border-radius: var(--global-radius-pill);
    background: none;
    color: var(--theme-text-muted);
    cursor: pointer;
    transition: border-color var(--theme-transition-default), transform 90ms ease-out;
    flex-shrink: 0;
  }

  .search-trigger:hover {
    border-color: var(--theme-text-muted);
  }

  .search-trigger:active {
    transform: scale(0.96);
  }

  .search-trigger:focus-visible {
    outline: 2px solid var(--theme-border-focus-ring);
    outline-offset: 2px;
  }

  .search-trigger__icon {
    width: var(--global-icon-size-sm);
    height: var(--global-icon-size-sm);
    flex-shrink: 0;
  }

  .search-trigger__label {
    font-size: var(--global-font-size-sm);
  }

  .search-trigger__kbd {
    font-family: var(--global-font-family-mono);
    font-size: var(--global-font-size-xs);
    background-color: var(--theme-surface-muted);
    padding: 2px var(--global-size-unit-1);
    border-radius: var(--global-radius-sm);
  }

  /* ── Overlay ───────────────────────────────────────────── */
  .search-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(2px);
    z-index: var(--global-z-index-toast);
    align-items: flex-start;
    justify-content: center;
    padding-top: 15vh;
  }

  .search-backdrop--visible {
    display: flex;
  }

  .search-panel {
    width: min(480px, 90vw);
    max-height: 60vh;
    background-color: var(--theme-surface-raised);
    border: 1px solid var(--theme-border-default);
    border-radius: var(--global-radius-lg);
    box-shadow: var(--global-shadow-lg);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .search-panel__field {
    display: flex;
    align-items: center;
    gap: var(--global-size-unit-2);
    padding: var(--global-size-unit-3) var(--global-size-unit-4);
    border-bottom: 1px solid var(--theme-border-subtle);
  }

  .search-panel__icon {
    width: var(--global-icon-size-sm);
    height: var(--global-icon-size-sm);
    color: var(--theme-text-muted);
    flex-shrink: 0;
  }

  .search-panel__input {
    flex: 1;
    border: none;
    background: none;
    outline: none;
    font-family: var(--global-font-family-sans);
    font-size: var(--global-font-size-base);
    color: var(--theme-text-default);
  }

  .search-panel__input::placeholder {
    color: var(--theme-text-subtle);
  }

  .search-panel__esc {
    font-family: var(--global-font-family-mono);
    font-size: var(--global-font-size-xs);
    color: var(--theme-text-muted);
    background-color: var(--theme-surface-muted);
    padding: 2px var(--global-size-unit-1);
    border-radius: var(--global-radius-sm);
    flex-shrink: 0;
  }

  .search-panel__results {
    overflow-y: auto;
    padding: var(--global-size-unit-2);
  }

  .search-panel__group {
    font-size: var(--global-font-size-xs);
    font-weight: var(--global-font-weight-semibold);
    color: var(--theme-text-muted);
    text-transform: uppercase;
    letter-spacing: var(--global-letter-spacing-wide);
    padding: var(--global-size-unit-2) var(--global-size-unit-2) var(--global-size-unit-1);
  }

  .search-panel__result {
    display: block;
    padding: var(--global-size-unit-2);
    border-radius: var(--global-radius-md);
    font-size: var(--global-font-size-sm);
    color: var(--theme-text-default);
    text-decoration: none;
  }

  .search-panel__result--active {
    background-color: var(--theme-surface-muted);
  }

  .search-panel__empty {
    padding: var(--global-size-unit-4);
    font-size: var(--global-font-size-sm);
    color: var(--theme-text-muted);
    text-align: center;
  }

  /* ── Mobile: icon-only trigger ─────────────────────────── */
  @media (max-width: 768px) {
    .search-trigger {
      width: var(--global-control-height-31);
      padding: 0;
      justify-content: center;
    }

    .search-trigger__label,
    .search-trigger__kbd {
      display: none;
    }
  }
</style>
